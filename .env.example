# TechStar AI / OpenRouter
# Create your key in the OpenRouter dashboard.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Nemotron 3 Ultra (free variant)
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional: shown to OpenRouter for rankings/analytics
OPENROUTER_SITE_URL=https://your-techstar-domain.vercel.app
OPENROUTER_SITE_NAME=TechStar AI

# Existing TechStar database variable
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/techstar
